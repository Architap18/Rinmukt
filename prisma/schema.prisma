// Prisma Schema for Karza Untangler

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  name             String
  phone            String?
  email            String        @unique
  passwordHash     String
  monthlySurplus   Float         @default(3000.0)
  monthlyIncome    Float?
  selectedStrategy String        @default("avalanche")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  debts          Debt[]
  paymentPlans   PaymentPlan[]
}

model Debt {
  id                   String       @id @default(uuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lenderName           String
  lenderType           String       // relative | shopkeeper | moneylender | chit_fund | bnpl | other
  principalAmount      Float
  remainingBalance     Float
  interestDescription  String?
  interestType         String       // none | flat_monthly | compound_monthly | one_time_flat | unspecified
  interestRate         Float        // percentage per month/period or flat
  startDate            DateTime?
  durationMonths       Int          @default(12)
  repaymentExpectation String
  socialWeight         String       // low | medium | high
  
  effectiveAnnualCost  Float        // EAC (%) computed deterministically
  monthlyBleed         Float        // Monthly interest cost (₹)
  urgencyTier          String       // low | medium | high (financial urgency)
  financialUrgency     String?      // low | medium | high
  relationalUrgency    String?      // low | medium | high

  status               String       @default("active") // active | paid_off
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  paymentLogs          PaymentLog[]
}

model PaymentPlan {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy       String   // fastest | balanced
  monthlySurplus Float
  scheduleJson   String   // JSON string of full payoff timeline and month allocations
  generatedAt    DateTime @default(now())
}

model PaymentLog {
  id         String   @id @default(uuid())
  debtId     String
  debt       Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amountPaid Float
  paidAt     DateTime @default(now())
  notes      String?
}
