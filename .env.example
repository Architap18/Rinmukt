# ─────────────────────────────────────────────────────────────────────────────
# Rinmukht — Environment Variables Template
# Copy this file to .env and fill in your values.
# Copy to .env.local and fill in real values. Never commit secrets.
#
# ── DATABASE (not required) ─────────────────────────────────────────────────
# The judging walkthrough does not use PostgreSQL. Login is hardcoded and
# debts live in a session cookie only. You can leave DATABASE_URL unset.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── AUTHENTICATION ──────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-secret"

# ── AI / GEMINI (Optional) ──────────────────────────────────────────────────
# Powers Hindi/Marathi/Hinglish voice debt explanations.
# Get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key-here"
