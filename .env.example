# ─────────────────────────────────────────────────────────────────────────────
# Rinmukht — Environment Variables Template
# Copy this file to .env and fill in your values.
# Copy to .env.local and fill in real values. Never commit secrets.
#
# ── DATABASE ────────────────────────────────────────────────────────────────
# This project uses PostgreSQL for BOTH local development and production.
# Get a free DB from: https://neon.tech  (recommended for Vercel)
# After creating a database, copy the connection string below.
# Neon example:
#   postgresql://johndoe:pass@ep-cool-wind.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── AUTHENTICATION ──────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-secret"

# ── AI / GEMINI (Optional) ──────────────────────────────────────────────────
# Powers Hindi/Marathi/Hinglish voice debt explanations.
# Get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key-here"
